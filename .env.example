# UYI 记忆插件的模型设置。复制成 .env 再填；不要提交 .env。
# 用 HTTP 服务时默认读 <数据目录>/.env（数据目录默认 ~/.uyi-memory，可用 --data 改）。
# 当 Node 模块用时，把这些键作为 env 对象传给 createMemory()。
# LLM_PROVIDER=mock 时不调任何接口、不花钱（测试和开发用）。
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 后台任务（抽事实、写观察、离屏补完）用的模型，留空就和 LLM_MODEL 一样：
LLM_MODEL_BACKGROUND=
# 原样合并进每个请求体的 JSON。deepseek-flash 默认开思考，后台任务会把 max_tokens 全花在推理上、正文为空，所以默认关掉：
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# 价格（美元 / 百万 token），只用来记花费：
LLM_PRICE_INPUT=
LLM_PRICE_CACHED=
LLM_PRICE_OUTPUT=
