        { "goal": "给他一个提示（北边、勺子形的那几颗），让他自己找，别直接说", "done_when": "model" },
        { "goal": "告诉他这颗叫铜钩星，是师父教的叫法，书上叫别的", "done_when": "model" }
      ],
      "end_effects": null, "memory_template": "我们一起认了铜钩星，是{user}自己找到的" },
    { "id": "watch", "name": "守夜", "start_when": { "sky_in": ["夜里"], "commitment_due_today": "守夜" }, "max_turns": 10,
      "steps": [
        { "goal": "定好谁先守、守到几点", "done_when": "model" },
        { "goal": "守着火聊一会儿：可以讲一件过往，或者问他一件事", "done_when": "model" },
        { "goal": "到点换班，嘱咐他一句", "done_when": "model" }
      ],
      "end_effects": { "add": { "lan_tired": 1 }, "commitment_done": "守夜" }, "memory_template": "我们一起守了一夜",
      "night_boost": { "incidents": ["wolf_howl", "meteor"], "p_times": 3 } },
    { "id": "nuts", "name": "烤松子", "start_when": { "object": { "campfire-1": { "lit": true } }, "custom": "nuts_ready" }, "max_turns": 5,
      "steps": [
        { "goal": "教他怎么烤：埋在火边的灰里，别直接扔火上", "done_when": "model" },
        { "goal": "等着，看他会不会忍不住去翻", "done_when": { "user_said_any": ["翻", "好了吗", "熟了", "拿"] } },
        { "goal": "按结果说一句（烤糊了就笑他，刚好就分他一半）", "done_when": "model", "roll": { "p": 0.3, "yes": "烤糊了", "no": "刚刚好" } }
      ],
      "end_effects": { "add_unless_rolled": { "food": 1 }, "use_up": "pine-nuts" }, "memory_template": "我们烤了一把松子，{result}" }
