{
  "note": "3.0 F4：营地的意外表（docs/PLAN-3.0.md 附录 C.4）。字段见 contracts/world.md。宿主读，模型只看到发生了的那几条。",
  "world_words": ["帐篷", "绳", "油布", "狐狸", "脚印", "口粮", "狼", "流星", "猎人", "阿砾", "溪", "雪线", "山口", "初雪", "湿"],
  "incidents": [
    { "id": "wet_wood", "name": "柴受潮", "sev": 1, "check": "on_weather", "p": 1, "cooldown_days": 0,
      "when": { "weather_in": ["小雨", "大雨", "雪"], "var": { "wood_covered": false, "wood_wet": false } },
      "effects": { "set": { "wood_wet": true } }, "resolve_when": { "var": { "wood_wet": false } },
      "text": "下雨了，柴没盖，全湿了", "memory": false },
    { "id": "rain_fire_out", "name": "大雨浇灭了火", "sev": 1, "check": "on_weather", "p": 1, "cooldown_days": 0,
      "when": { "weather_in": ["大雨"], "object": { "campfire-1": { "lit": true } } },
      "effects": { "fire_out": "campfire-1" }, "resolve": [{ "by": "char", "action": "tend_fire", "target": "campfire-1" }],
      "deadline_h": 6, "auto_fix": { "action": "tend_fire", "target": "campfire-1", "after_h": 1 },
      "text": "大雨把篝火浇灭了", "memory": false },
    { "id": "tent_rope", "name": "帐篷绳松了", "sev": 2, "check": "hourly", "p": 0.4, "cooldown_days": 2,
      "when": { "weather_in": ["大风"], "var": { "tent_secure": true } },
      "effects": { "set": { "tent_secure": false } }, "target": "tent-1",
      "resolve": [{ "by": "char", "action": "fix_tent", "target": "tent-1" }, { "by": "user", "action": "help" }],
      "deadline_h": 3, "on_expire": { "set": { "tent_down": true } }, "auto_fix": { "action": "fix_tent", "target": "tent-1", "after_h": 1 },
      "text": "风太大，帐篷的绳子松了", "memory": true },
    { "id": "tarp_blown", "name": "盖柴的油布被吹走", "sev": 1, "check": "hourly", "p": 0.3, "cooldown_days": 1,
      "when": { "weather_in": ["大风"], "var": { "wood_covered": true } },
      "effects": { "set": { "wood_covered": false } }, "target": "wood-crate-1",
      "resolve": [{ "by": "either", "action": "cover_wood", "target": "wood-crate-1" }],
      "deadline_h": 4, "auto_fix": { "action": "cover_wood", "target": "wood-crate-1", "after_h": 2 },
      "text": "风把盖柴的油布掀跑了", "memory": false },
    { "id": "cup_muddy", "name": "杯子被风吹到地上", "sev": 2, "check": "hourly", "p": 0.3, "cooldown_days": 3,
      "when": { "weather_in": ["大风"], "object": { "cup": { "holder": null, "worn_by": null } }, "char_outdoors": true },
      "effects": { "object": { "cup": { "state.dirty": true, "on": null, "pos.1": 0.05 } } }, "target": "cup",
      "resolve": [{ "by": "char", "action": "clean", "target": "cup" }, { "by": "either", "action": "pick_up", "target": "cup" }],
      "on_resolve": { "object": { "cup": { "state.dirty": false } } },
      "deadline_h": 24, "auto_fix": { "action": "clean", "target": "cup", "after_h": 1 },
      "text": "风把潮青陶杯吹到了地上，没碎，沾了泥", "memory": true },
    { "id": "fox_food", "name": "口粮被翻了", "sev": 2, "check": "daily@02:00", "p": 0.15, "cooldown_days": 3,
      "when": { "hour_between": ["01:00", "04:00"], "var": { "food": { "gte": 1 } }, "not": { "var_future": "crate_secure_until" } },
      "effects": { "add": { "food": -1 }, "marks": "fox_tracks" }, "target": "wood-crate-1",
      "resolve": [{ "by": "char", "action": "secure_crate", "target": "wood-crate-1" }], "deadline_h": 24,
      "text": "夜里有东西翻了木箱，偷走一天的口粮，地上有小脚印", "memory": true },
    { "id": "wolf_howl", "name": "远处狼嚎", "sev": 1, "check": "hourly", "p": 0.2, "cooldown_days": 2,
      "when": { "sky_in": ["夜里"], "user_present": true },
      "text": "远处传来几声狼嚎", "memory": false },
    { "id": "meteor", "name": "流星", "sev": 1, "check": "hourly", "p": 0.15, "cooldown_days": 3,
      "when": { "sky_in": ["夜里"], "weather_in": ["晴"], "user_present": true },
      "text": "天上划过一颗流星", "memory": true },
    { "id": "hunter_news", "name": "猎人捎话", "sev": 2, "check": "daily@15:00", "p": 0.25, "cooldown_days": 4,
      "when": { "day_gte": 3, "hour_between": ["14:00", "17:30"], "weather_in": ["晴", "阴", "起雾"] },
      "news": { "初识": "镇上的人说今年雪化得晚。", "熟悉": "北坡脚有人见过一个旧营火堆，看着有几年了。", "亲近": "有个猎人在北坡捡到过一枚铜扣子，上面刻着羽毛。" },
      "text": "一个路过的猎人在小路上和岚说了几句话", "memory": true },
    { "id": "ali_letter", "name": "阿砾捎信", "sev": 1, "check": "daily@15:00", "p": 1, "cooldown_days": 999,
      "when": { "day_gte": 4 }, "effects": { "add": { "ali_eta_days": 2 } },
      "text": "猎人捎来阿砾的话：镇上补给车坏了，要晚两天回来", "memory": true },
    { "id": "creek_rise", "name": "溪水涨了", "sev": 1, "check": "daily@05:00", "p": 1, "cooldown_days": 0,
      "when": { "yesterday_weather_in": ["大雨"] }, "auto_resolve_h": 24,
      "text": "下了一夜大雨，南边的溪水涨了", "memory": false },
    { "id": "first_snow", "name": "初雪", "sev": 3, "check": "on_weather", "p": 1, "cooldown_days": 999,
      "when": { "weather_in": ["雪"] },
      "text": "下雪了，今年第一场", "memory": true },
    { "id": "pass_open", "name": "雪线过了山口", "sev": 3, "check": "daily@08:00", "p": 1, "cooldown_days": 999,
      "when": { "var": { "pass_open": true, "snowline_seen": { "gte": "$pass_height" } } },
      "text": "岚早上看北坡，雪线已经过了山口", "memory": true }
  ]
}
