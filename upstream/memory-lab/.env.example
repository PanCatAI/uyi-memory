# 记忆实验台的服务端设置。复制成 .env 再填；不要提交 .env。
# 应用里改在设置页，存到 ~/Library/Application Support/UYI Memory Lab/.env
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_MODEL_BACKGROUND=
# 人设漂移检测（npm run drift）的裁判模型，要和 LLM_MODEL 不同；留空就不打分：
LLM_MODEL_JUDGE=
# 原样合并进每个请求体的 JSON。deepseek-flash 默认开思考，后台任务会把 max_tokens 全花在推理上、正文为空，
# 所以默认关掉思考：
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
LLM_PRICE_INPUT=
LLM_PRICE_CACHED=
LLM_PRICE_OUTPUT=
