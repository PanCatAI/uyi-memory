{
  "id": "trust-secret",
  "title": "保守秘密：不在场的角色不知道；在场的角色默认不转述",
  "scene": "island",
  "user_name": "你",
  "steps": [
    { "session": "start" },
    { "say": "偷偷告诉你，我在给阿乔准备生日礼物，别告诉他", "to": "rin" },
    { "wait_jobs": true },
    { "expect": { "event": { "type": "user_said", "perceivers_exclude": "qiao", "min": 1 } } },
    { "say": "阿乔，最近打到什么鱼了", "to": "qiao" },
    { "expect": { "context_excludes": ["生日礼物"] } },
    { "act": { "action": "move_character", "target": "qiao", "args": { "room": "cabin" } } },
    { "say": "玲，礼物的事你记得保密哦", "to": "rin" },
    { "say": "阿乔你来啦，坐", "to": "qiao" },
    { "expect": { "context_excludes": ["礼物"] } },
    { "expect": { "context_section_contains": { "section": "overheard", "text": "玲" } } },
    { "expect": { "reply_not_contains": ["生日礼物"], "live_only": true } }
  ]
}
